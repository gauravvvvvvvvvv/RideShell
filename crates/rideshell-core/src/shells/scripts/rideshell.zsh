# @CMD@ shell integration for zsh.
# Generated by `@CMD@ hook zsh`; safe to source more than once.
# Defines a `@CMD@` function (so `@CMD@ profile use` can change this session)
# and a precmd hook that applies directory-bound profiles after `cd`.

typeset -g @FN@_bin=@BIN@
typeset -g @FN@_last=
typeset -g @FN@_indicator=@INDICATOR@
typeset -g @FN@_seg=
export @ENV_SHELL@=zsh

# Tool shims (claude, codex, gh, ...) go first on PATH.
@FN@_shims=@SHIMS@
if command -v cygpath >/dev/null 2>&1; then @FN@_shims="$(cygpath -u "$@FN@_shims")"; fi
case ":$PATH:" in
  *":$@FN@_shims:"*) ;;
  *) export PATH="$@FN@_shims:$PATH" ;;
esac

@FN@_sync() {
  if [[ "$1" != force && "$PWD" == "$@FN@_last" ]]; then return 0; fi
  @FN@_last="$PWD"
  local __code
  __code="$("$@FN@_bin" hook-env --shell zsh)" || return 0
  if [[ "$__code" == "@MARKER@"* ]]; then eval "$__code"; fi
  return 0
}

@FN@_precmd() {
  @FN@_sync
  if [[ "$@FN@_indicator" == 1 ]]; then
    local __seg=
    if [[ -n "$@ENV_ACTIVE@" && "$@ENV_PROMPT@" != 0 ]]; then
      __seg="%F{111}[${@ENV_ACTIVE@}]%f "
    fi
    PROMPT="$__seg${PROMPT#"$@FN@_seg"}"
    @FN@_seg="$__seg"
  fi
}

@CMD@() {
  if [[ "$1" == profile && "$2" == use ]]; then
    shift 2
    local __out __status
    __out="$("$@FN@_bin" profile use "$@" --emit zsh)"
    __status=$?
    if [[ $__status -eq 0 && "$__out" == "@MARKER@"* ]]; then
      eval "$__out"
    elif [[ -n "$__out" ]]; then
      print -r -- "$__out"
    fi
    @FN@_sync force
    return $__status
  fi
  "$@FN@_bin" "$@"
  local __status=$?
  @FN@_sync force
  return $__status
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd @FN@_precmd

@FN@_sync force
